@model EmployeePortalApp.models.empData

<html>
<head>
    <title>Employee Registration</title>
   
</head>


    <h2>Employee Registration</h2>
   

      <form asp-controller="Employee" asp-action="Details" method="post">

        <label>Full Name</label><br />
        <input type="text" asp-for="FullName" placeholder="Enter Full Name" required />
        <br /><br />

        <label>Email Address</label><br />
        <input type="email" asp-for="Email" placeholder="Enter Email" required />
        <br /><br />

        <label>Password</label><br />
        <input type="password" asp-for="Password" placeholder="Enter Password" required />
        <br /><br />

        <label>Confirm Password</label><br />
        <input type="password" asp-for="ConfirmPassword" placeholder="Confirm Password" required />
        <br /><br />

        <button type="submit">Register</button>

    </form>


</html>